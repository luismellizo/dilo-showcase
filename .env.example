# ---------------------------------------------------------------------------
# Variables de entorno — plantilla
#
# ⚠️  Este archivo es DELIBERADAMENTE INCOMPLETO. Es un snapshot de portafolio,
#     no una guía de despliegue: faltan variables del motor de IA y del canal
#     de mensajería, y el proyecto NO levanta solo con esto.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ----------------------------------------------------------
# Sin DB_NAME el proyecto cae a SQLite (dev).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache, Channels y broker de Celery) ------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- URLs públicas ----------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=

# --- Correo saliente (SMTP) --------------------------------------------------
# Sin EMAIL_HOST_PASSWORD el backend usa el backend de consola.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Panel interno ----------------------------------------------------------
STAFF_EMAIL_DOMAINS=
STAFF_MFA_CODE_TTL=180
STAFF_SESSION_HOURS=2

# --- Facturación ------------------------------------------------------------
TRIAL_DAYS=14
WINBACK_DAYS=14

# --- Observabilidad (opcional) ----------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development

# ---------------------------------------------------------------------------
# OMITIDO EN ESTE SNAPSHOT PÚBLICO
#
# El repo privado define además la configuración de:
#   · proveedor y modelos de IA (texto, visión, generación de imagen)
#   · WhatsApp Business Cloud API y la app de Meta para Embedded Signup
#   · bot de Telegram
#   · pasarela de pagos
#   · OAuth de Google
#
# No se listan aquí ni siquiera como nombres vacíos: la elección de
# proveedores y su combinación es parte de lo que no se publica.
# ---------------------------------------------------------------------------
